<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#F5F7F7" />
            <stroke android:width="1dp" android:color="#E5EAEA" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#EAF8F9" />
            <stroke android:width="1dp" android:color="#4BB5C1" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F4FAFA" />
            <stroke android:width="1dp" android:color="#4BB5C1" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="1dp" android:color="#D4ECEE" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
