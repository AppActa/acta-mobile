<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCicloProgressoItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/bg_inicio_card_escuro"
    android:elevation="4dp"
    android:padding="20dp">

    <!-- Subtítulo "Suas tarefas" -->
    <TextView
        android:id="@+id/txtSuasTarefasHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/plus_jakarta_sans"
        android:text="Suas tarefas"
        android:textColor="#6DD6AA"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Título Principal "Você tem 12 tarefas" -->
    <TextView
        android:id="@+id/txtTotalTarefas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:text="Você tem 12 tarefas"
        android:textColor="#F1F3F4"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtSuasTarefasHeader" />

    <!-- Rótulo "Progresso das tarefas" -->
    <TextView
        android:id="@+id/lblProgressoTarefas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:text="Progresso das tarefas"
        android:textColor="#AFB7B9"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTotalTarefas" />

    <!-- Porcentagem "25%" -->
    <TextView
        android:id="@+id/txtPorcentagemProgresso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/plus_jakarta_sans"
        android:text="25%"
        android:textColor="#F1F3F4"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/lblProgressoTarefas"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/lblProgressoTarefas" />

    <!-- Barra de Progresso Horizontal -->
    <ProgressBar
        android:id="@+id/progressBarCiclo"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:progress="25"
        android:progressDrawable="@drawable/bg_progress_bar_custom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblProgressoTarefas" />

    <!-- Botão "Abrir planos de ação" -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAbrirPlanosAcao"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_btn_enviar_resposta"
        android:clickable="true"
        android:elevation="3dp"
        android:focusable="true"
        android:fontFamily="@font/plus_jakarta_sans"
        android:foreground="?attr/selectableItemBackground"
        android:text="Abrir planos de ação"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBarCiclo" />

</androidx.constraintlayout.widget.ConstraintLayout>
