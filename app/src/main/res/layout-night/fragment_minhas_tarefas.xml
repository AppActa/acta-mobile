<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_inicio_cabecalho_escuro">

    <!-- 1. Cabeçalho Superior com Botão Voltar (Fixo) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerMinhasTarefas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnVoltarMinhasTarefas"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar"
            android:scaleType="fitCenter"
            android:src="@drawable/voltar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. Cartão Branco Fixo no Topo (Título e Busca Fixos) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerFixoTopo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_inicio_fundo_escuro"
        android:paddingHorizontal="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerMinhasTarefas">

        <TextView
            android:id="@+id/txtTituloMinhasTarefas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Minhas tarefas"
            android:textColor="#F1F3F4"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/edtBuscarTarefa"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_inicio_campo_escuro"
            android:fontFamily="@font/plus_jakarta_sans"
            android:hint="Buscar tarefa"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:textColor="#F1F3F4"
            android:textColorHint="#AFB7B9"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtTituloMinhasTarefas" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFiltrarStatusTarefas"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_status_pill"
            android:fontFamily="@font/plus_jakarta_sans"
            android:paddingHorizontal="16dp"
            android:text="Filtrar por status"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/edtBuscarTarefa" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 3. RecyclerView Rolável (Apenas a lista rola abaixo da busca) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTodasTarefas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#1D2225"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="32dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/containerFixoTopo"
        tools:listitem="@layout/item_card_tarefa" />

</androidx.constraintlayout.widget.ConstraintLayout>
