<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp" android:layout_marginVertical="4dp"
    android:minHeight="100dp" android:background="@drawable/bg_chat_suggestion"
    android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp"
    android:paddingTop="10dp" android:paddingBottom="8dp"
    android:clickable="true" android:focusable="true"
    android:foreground="?attr/selectableItemBackground">
    <ImageView android:layout_width="18dp" android:layout_height="18dp"
        android:importantForAccessibility="no" android:src="@drawable/chat_sparkle" />
    <TextView android:id="@+id/suggestionTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:fontFamily="@font/plus_jakarta_sans" android:includeFontPadding="false"
        android:lineHeight="17dp" android:textColor="#173A40" android:textSize="13sp"
        android:textFontWeight="600"
        tools:text="@sample/chat_suggestions.json/suggestions/title" />
    <TextView android:id="@+id/suggestionDescription" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:fontFamily="@font/plus_jakarta_sans"
        android:includeFontPadding="false" android:lineHeight="15dp"
        android:textColor="#60777C" android:textSize="11sp"
        tools:text="@sample/chat_suggestions.json/suggestions/description" />
</LinearLayout>
