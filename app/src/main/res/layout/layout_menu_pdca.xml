<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/containerMenuPdca"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:background="@drawable/bg_menu_inferior"
    android:baselineAligned="false"
    android:clipToOutline="true"
    android:elevation="12dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:outlineProvider="background"
    android:paddingHorizontal="8dp">

    <!-- 1. Geral -->
    <FrameLayout
        android:id="@+id/btnMenuGeral"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <LinearLayout
            android:id="@+id/containerGeral"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_menu_active_circle"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgGeral"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Geral"
                android:scaleType="fitCenter"
                android:src="@drawable/img"
                app:tint="#083248" />

            <TextView
                android:id="@+id/txtGeral"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Geral"
                android:textColor="#083248"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- 2. Plan -->
    <FrameLayout
        android:id="@+id/btnMenuPlan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <LinearLayout
            android:id="@+id/containerPlan"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgPlan"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Plan"
                android:scaleType="fitCenter"
                android:src="@drawable/plan"
                app:tint="#212121" />

            <TextView
                android:id="@+id/txtPlan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Plan"
                android:textColor="#212121"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- 3. Do -->
    <LinearLayout
        android:id="@+id/btnMenuDo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="4dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Do"
            android:scaleType="fitCenter"
            android:src="@drawable/codex_play" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Do"
            android:textColor="#00A7B5"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. Check -->
    <LinearLayout
        android:id="@+id/btnMenuCheck"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="4dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Check"
            android:scaleType="fitCenter"
            android:src="@drawable/basil_book_check_outline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Check"
            android:textColor="#238357"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 5. Act -->
    <LinearLayout
        android:id="@+id/btnMenuAct"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="4dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Act"
            android:scaleType="fitCenter"
            android:src="@drawable/act" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Act"
            android:textColor="#006775"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
