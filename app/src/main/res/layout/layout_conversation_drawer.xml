<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF" android:elevation="12dp" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="28dp" android:paddingBottom="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="82dp" android:layout_height="38dp" android:contentDescription="ACTA" android:scaleType="fitStart" android:src="@drawable/logo_azul" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:fontFamily="@font/plus_jakarta_sans" android:id="@+id/buttonCloseHistory" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="×" android:textColor="#253132" android:textSize="28sp" />
    </LinearLayout>
    <TextView android:fontFamily="@font/plus_jakarta_sans" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Conversas" android:textColor="#253132" android:textSize="23sp" android:textStyle="bold" />
    <TextView android:fontFamily="@font/plus_jakarta_sans" android:id="@+id/buttonNewConversation" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="16dp" android:background="@drawable/bg_chat_action" android:gravity="center" android:text="＋  Nova conversa" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
    <EditText android:fontFamily="@font/plus_jakarta_sans" android:id="@+id/historySearch" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:background="@drawable/bg_chat_input" android:hint="Buscar conversas" android:inputType="text" android:paddingStart="14dp" android:paddingEnd="14dp" android:textSize="13sp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/historyList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="16dp" android:layout_weight="1" android:clipToPadding="false" />
    <LinearLayout android:id="@+id/chatProfileAction" android:layout_width="match_parent" android:layout_height="60dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:contentDescription="Abrir perfil" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:fontFamily="@font/plus_jakarta_sans" android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_chat_user_message" android:gravity="center" android:text="G" android:textColor="#173A40" android:textSize="17sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:fontFamily="@font/plus_jakarta_sans" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gabriel Vigna" android:textColor="#253132" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:fontFamily="@font/plus_jakarta_sans" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Minha conta" android:textColor="#66707A" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
