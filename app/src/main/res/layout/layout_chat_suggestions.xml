<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_horizontal" android:orientation="vertical"
    android:paddingTop="8dp" android:paddingBottom="10dp">
    <ImageView android:layout_width="96dp" android:layout_height="92dp"
        android:contentDescription="Cato" android:padding="7dp" android:scaleType="fitCenter" android:src="@drawable/cato_cabeca" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:fontFamily="@font/plus_jakarta_sans"
        android:gravity="center" android:includeFontPadding="false" android:lineHeight="30dp"
        android:text="Olá, Gabriel.\nComo posso ajudar?" android:textColor="#253132"
        android:textSize="24sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:fontFamily="@font/plus_jakarta_sans"
        android:gravity="center" android:includeFontPadding="false" android:lineHeight="18dp"
        android:text="Do planejamento à próxima entrega,\nconte comigo para cuidar do seu ciclo."
        android:textColor="#66707A" android:textSize="12sp" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"
        tools:itemCount="4"
        tools:listitem="@layout/item_suggestion" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:fontFamily="@font/plus_jakarta_sans"
        android:gravity="center" android:includeFontPadding="false" android:lineHeight="13dp"
        android:text="Escreva sua pergunta para começar" android:textColor="#66707A" android:textSize="9sp" />
</LinearLayout>
