<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/imagemFundoBoasVindas"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 1. Topo Verde-Água (Cabeçalho com botão voltar, ícone, título e status) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerDetalhesCiclo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Botão Voltar -->
            <ImageButton
                android:id="@+id/btnVoltarDetalhesCiclo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Voltar"
                android:scaleType="fitCenter"
                android:src="@drawable/voltar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Ícone Quadrado do Ciclo -->
            <FrameLayout
                android:id="@+id/containerIconeCicloDetalhe"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_principal"
                android:elevation="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnVoltarDetalhesCiclo">

                <ImageView
                    android:id="@+id/imgIconeCicloDetalhe"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:contentDescription="Ícone do Ciclo"
                    android:src="@drawable/reicon_profile_2user_filled"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <!-- Título do Ciclo (Ao lado do ícone) -->
            <TextView
                android:id="@+id/txtTituloCicloDetalhe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Organização do estoque"
                android:textColor="#111111"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/containerIconeCicloDetalhe"
                app:layout_constraintTop_toTopOf="@id/containerIconeCicloDetalhe" />

            <!-- Badge Status do Ciclo (Abaixo do título) -->
            <TextView
                android:id="@+id/txtStatusCicloDetalhe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_status_pill"
                android:fontFamily="@font/plus_jakarta_sans"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:text="Status: Plan"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/txtTituloCicloDetalhe"
                app:layout_constraintTop_toBottomOf="@id/txtTituloCicloDetalhe" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 2. Cartão Branco que ocupa todo o resto da tela -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerDetalhesCicloBranco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_cartao_topo_arredondado"
            android:minHeight="600dp"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerDetalhesCiclo"
            app:layout_constraintVertical_bias="0.0">

            <!-- Informações do Ciclo (Responsável, Datas) -->
            <TextView
                android:id="@+id/txtResponsavelCiclo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Responsável pelo ciclo: Catarina Cândido"
                android:textColor="#616161"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txtDataInicioCiclo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Iniciado em: 26/05/2026"
                android:textColor="#616161"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtResponsavelCiclo" />

            <TextView
                android:id="@+id/txtPrazoFinalCiclo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Prazo final: 30/10/2026"
                android:textColor="#616161"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtDataInicioCiclo" />

            <!-- Título de Seção "Planejamento" -->
            <TextView
                android:id="@+id/lblPlanejamento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Planejamento"
                android:textColor="#083248"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtPrazoFinalCiclo" />

            <!-- Cartão 1: Análise de causas -->
            <include
                android:id="@+id/cardAnaliseCausasInclude"
                layout="@layout/item_card_analise_causas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblPlanejamento" />

            <!-- Cartão 2: Plano 5W2H Fixo -->
            <include
                android:id="@+id/cardPlano5W2HInclude"
                layout="@layout/item_card_plano_5w2h"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardAnaliseCausasInclude" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
