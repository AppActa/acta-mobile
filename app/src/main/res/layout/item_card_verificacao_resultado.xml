<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardVerificacaoResultado"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/bg_card_white"
    android:elevation="4dp"
    android:padding="20dp">

    <!-- Subtítulo "Resultado atual" -->
    <TextView
        android:id="@+id/lblResultadoAtual"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/plus_jakarta_sans"
        android:text="Resultado atual"
        android:textColor="#238357"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/txtStatusVerificacaoBadge"
        app:layout_constraintEnd_toStartOf="@id/txtStatusVerificacaoBadge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtStatusVerificacaoBadge" />

    <!-- Status Badge (Ex: Parcial) -->
    <TextView
        android:id="@+id/txtStatusVerificacaoBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_pill"
        android:fontFamily="@font/plus_jakarta_sans"
        android:paddingHorizontal="16dp"
        android:paddingVertical="5dp"
        android:text="Parcial"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Descrição / Observação do Resultado -->
    <TextView
        android:id="@+id/txtObservacaoResultado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:lineSpacingExtra="2dp"
        android:textColor="#616161"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtStatusVerificacaoBadge"
        tools:text="As divergências caíram de 8% para 3.5%, mas a meta ainda não foi alcançada." />

    <!-- Botão "Ver efeitos secundários" -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnVerEfeitosSecundarios"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_btn_enviar_resposta"
        android:clickable="true"
        android:elevation="3dp"
        android:focusable="true"
        android:fontFamily="@font/plus_jakarta_sans"
        android:foreground="?attr/selectableItemBackground"
        android:text="Ver efeitos secundários"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtObservacaoResultado" />

</androidx.constraintlayout.widget.ConstraintLayout>
