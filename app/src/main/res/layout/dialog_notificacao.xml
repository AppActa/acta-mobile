<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_arredondado"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tituloDialogNotificacao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textColor="#111111"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/voltarDialogNotificacao"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Voltar"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/voltar" />
        </LinearLayout>

        <TextView
            android:id="@+id/categoriaDialogNotificacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_notificacoes_resumo"
            android:fontFamily="@font/plus_jakarta_sans"
            android:gravity="center_vertical"
            android:minHeight="32dp"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textColor="#267F89"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detalhesDialogNotificacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_notificacoes_resumo"
            android:fontFamily="@font/plus_jakarta_sans"
            android:lineSpacingExtra="6dp"
            android:padding="16dp"
            android:textColor="#4F5B5C"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/erroDialogNotificacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textColor="#C62828"
            android:textSize="14sp"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/abrirDialogNotificacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_notificacoes_dialog_abrir"
            android:fontFamily="@font/plus_jakarta_sans"
            android:foreground="?attr/selectableItemBackground"
            android:minHeight="52dp"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:text="Abrir item"
            android:textAllCaps="false"
            android:textColor="@color/notificacoes_acao_principal_texto"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/lerDialogNotificacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_notificacoes_acao_secundaria"
            android:fontFamily="@font/plus_jakarta_sans"
            android:foreground="?attr/selectableItemBackground"
            android:minHeight="52dp"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:text="Marcar como lida"
            android:textAllCaps="false"
            android:textColor="@color/notificacoes_acao_secundaria_texto"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
