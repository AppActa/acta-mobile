<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardMetaItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/bg_card_white"
    android:elevation="4dp"
    android:padding="20dp">

    <!-- Subtítulo "Meta acompanhada" -->
    <TextView
        android:id="@+id/lblMetaAcompanhada"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/plus_jakarta_sans"
        android:text="Meta acompanhada"
        android:textColor="#238357"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Título Principal "Meta: chegar a 2%" -->
    <TextView
        android:id="@+id/txtObjetivoMeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/plus_jakarta_sans"
        android:maxLines="2"
        android:textColor="#083248"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblMetaAcompanhada"
        tools:text="Meta: chegar a 2%" />

    <!-- Item Bullet 1: Valor Base e Valor Alvo -->
    <TextView
        android:id="@+id/txtValoresBaseEAlvo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textColor="#616161"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtObjetivoMeta"
        tools:text="• Base: 8%  →  Alvo: 2%" />

    <!-- Item Bullet 2: Prazo -->
    <TextView
        android:id="@+id/txtResponsavelMeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textColor="#616161"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtValoresBaseEAlvo"
        tools:text="• Prazo: 30/10/2026" />

</androidx.constraintlayout.widget.ConstraintLayout>
