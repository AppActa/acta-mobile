<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardTarefasCicloItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/bg_card_white"
    android:elevation="4dp"
    android:padding="20dp">

    <!-- Subtítulo "Tarefas de ciclo" -->
    <TextView
        android:id="@+id/lblTarefasDeCiclo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/plus_jakarta_sans"
        android:text="Tarefas de ciclo"
        android:textColor="#238357"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Título Principal "1 de 2 tarefas concluídas" -->
    <TextView
        android:id="@+id/txtTituloTarefasCiclo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:text="1 de 2 tarefas concluídas"
        android:textColor="#083248"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblTarefasDeCiclo" />

    <!-- Rótulo "Progresso das tarefas" -->
    <TextView
        android:id="@+id/lblProgressoTarefasCiclo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:text="Progresso das tarefas"
        android:textColor="#757575"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTituloTarefasCiclo" />

    <!-- Porcentagem "50%" -->
    <TextView
        android:id="@+id/txtPorcentagemTarefasCiclo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/plus_jakarta_sans"
        android:text="50%"
        android:textColor="#111111"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/lblProgressoTarefasCiclo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/lblProgressoTarefasCiclo" />

    <!-- Barra de Progresso -->
    <ProgressBar
        android:id="@+id/progressBarTarefasCiclo"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:progress="50"
        android:progressDrawable="@drawable/bg_progress_bar_custom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblProgressoTarefasCiclo" />

    <!-- Sub-cartão interno da tarefa -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerSubTarefa"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_card_ciclo"
        android:padding="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBarTarefasCiclo">

        <TextView
            android:id="@+id/txtNomeSubTarefa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Organizar materiais"
            android:textColor="#083248"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtDetalhesSubTarefa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Vence 12 out · Em andamento"
            android:textColor="#757575"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtNomeSubTarefa" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Botão "Abrir minhas tarefas" -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAbrirMinhasTarefas"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_btn_enviar_resposta"
        android:clickable="true"
        android:elevation="3dp"
        android:focusable="true"
        android:fontFamily="@font/plus_jakarta_sans"
        android:foreground="?attr/selectableItemBackground"
        android:text="Abrir minhas tarefas"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/containerSubTarefa" />

</androidx.constraintlayout.widget.ConstraintLayout>
