<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/imagemFundoBoasVindas"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 1. Topo Verde-Água (Cabeçalho com botão voltar, título e breadcrumb) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerTarefasPlano"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Botão Voltar -->
            <ImageButton
                android:id="@+id/btnVoltarTarefasPlano"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Voltar"
                android:scaleType="fitCenter"
                android:src="@drawable/voltar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Título "Minhas tarefas" -->
            <TextView
                android:id="@+id/txtTituloMinhasTarefasHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Minhas tarefas"
                android:textColor="#111111"
                android:textSize="26sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnVoltarTarefasPlano" />

            <!-- Subtítulo / Breadcrumb "DO • MINHAS TAREFAS" -->
            <TextView
                android:id="@+id/txtBreadcrumbTarefasPlano"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="DO • MINHAS TAREFAS"
                android:textColor="#006775"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtTituloMinhasTarefasHeader" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 2. Cartão Branco que ocupa todo o resto da tela -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerTarefasPlanoBranco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cartao_topo_arredondado"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:minHeight="600dp"
            android:paddingHorizontal="8dp"
            android:paddingTop="20dp"
            android:paddingBottom="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerTarefasPlano"
            app:layout_constraintVertical_bias="0.0">

            <!-- Cartão de Progresso (Include) -->
            <include
                android:id="@+id/cardProgressoTarefasInclude"
                layout="@layout/item_card_tarefas_ciclo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- RecyclerView das Tarefas do Plano -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTarefasPlanoAcao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardProgressoTarefasInclude"
                tools:listitem="@layout/item_card_tarefa" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
