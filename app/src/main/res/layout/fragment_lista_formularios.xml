<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/imagemFundoBoasVindas"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 1. Topo Verde-Água (Cabeçalho Formulários) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerListaFormularios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Botão Voltar -->
            <ImageButton
                android:id="@+id/btnVoltarListaFormularios"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Voltar"
                android:scaleType="fitCenter"
                android:src="@drawable/voltar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Título "Formulários" -->
            <TextView
                android:id="@+id/txtTituloListaFormulariosHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Formulários"
                android:textColor="#111111"
                android:textSize="26sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnVoltarListaFormularios" />

            <!-- Subtítulo "Ciclo: [Nome do Ciclo]" -->
            <TextView
                android:id="@+id/txtSubtituloListaFormulariosHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textColor="#006775"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtTituloListaFormulariosHeader"
                tools:text="Ciclo: Reduzir retrabalho" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 2. Cartão Branco com Conteúdo -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerListaFormulariosBranco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cartao_topo_arredondado"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:minHeight="600dp"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerListaFormularios"
            app:layout_constraintVertical_bias="0.0">

            <!-- Campo de Busca -->
            <EditText
                android:id="@+id/edtBuscarFormularios"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:hint="Buscar ciclo"
                android:inputType="text"
                android:paddingHorizontal="16dp"
                android:textColor="#111111"
                android:textColorHint="#757575"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Botão Filtro por Status -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFiltrarPorStatusFormularios"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_status_pill"
                android:fontFamily="@font/plus_jakarta_sans"
                android:paddingHorizontal="16dp"
                android:text="Filtrar por status"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/edtBuscarFormularios" />

            <!-- RecyclerView dos Formulários -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvListaFormularios"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnFiltrarPorStatusFormularios"
                tools:listitem="@layout/item_card_formulario" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
