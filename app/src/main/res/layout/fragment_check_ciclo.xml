<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/imagemFundoBoasVindas"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 1. Topo Verde-Água (Cabeçalho do Ciclo) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerCheckCiclo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Botão Voltar -->
            <ImageButton
                android:id="@+id/btnVoltarCheckCiclo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Voltar"
                android:scaleType="fitCenter"
                android:src="@drawable/voltar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Ícone Quadrado Verde/Ciano da Caixa do Check -->
            <FrameLayout
                android:id="@+id/containerIconeCheck"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_circle_green"
                android:elevation="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnVoltarCheckCiclo">

                <ImageView
                    android:id="@+id/imgIconeCheck"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:contentDescription="Ícone Check"
                    android:src="@drawable/basil_book_check_outline"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <!-- Título do Ciclo (Ao lado do ícone) -->
            <TextView
                android:id="@+id/txtTituloCheckCiclo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Organização do estoque"
                android:textColor="#111111"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/containerIconeCheck"
                app:layout_constraintTop_toTopOf="@id/containerIconeCheck" />

            <!-- Badge Status "Etapa: Check" -->
            <TextView
                android:id="@+id/txtStatusCheckCiclo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_status_pill"
                android:fontFamily="@font/plus_jakarta_sans"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:text="Etapa: Check"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/txtTituloCheckCiclo"
                app:layout_constraintTop_toBottomOf="@id/txtTituloCheckCiclo" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 2. Cartão Branco com Conteúdo do Check -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerCheckBranco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_cartao_topo_arredondado"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:minHeight="600dp"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerCheckCiclo"
            app:layout_constraintVertical_bias="0.0">

            <!-- Responsável, Datas -->
            <TextView
                android:id="@+id/txtResponsavelCheck"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Responsável pelo ciclo: Catarina Cândido"
                android:textColor="#616161"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txtDataInicioCheck"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Iniciado em: —"
                android:textColor="#616161"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtResponsavelCheck" />

            <TextView
                android:id="@+id/txtPrazoFinalCheck"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Prazo final: —"
                android:textColor="#616161"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtDataInicioCheck" />

            <!-- Título da Seção: Check - Checagem -->
            <TextView
                android:id="@+id/txtTituloSecaoCheck"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Check — Checagem"
                android:textColor="#083248"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtPrazoFinalCheck" />

            <!-- Card Verificação Resultado (Include) -->
            <include
                android:id="@+id/cardVerificacaoResultadoInclude"
                layout="@layout/item_card_verificacao_resultado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtTituloSecaoCheck" />

            <!-- Mensagem quando não houver permissão / informações -->
            <TextView
                android:id="@+id/txtSemInformacoesCheck"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:gravity="center"
                android:text="Não existe informações nessa tela ainda"
                android:textColor="#757575"
                android:textSize="16sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtTituloSecaoCheck" />

            <!-- Título da Seção: Planos de ação -->
            <TextView
                android:id="@+id/txtTituloSecaoPlanosCheck"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Planos de ação"
                android:textColor="#083248"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardVerificacaoResultadoInclude" />

            <!-- RecyclerView dos Planos de Ação -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPlanosAcaoCheck"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtTituloSecaoPlanosCheck"
                tools:listitem="@layout/item_card_plano_acao" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
