<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/imagemFundoBoasVindas"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 1. Topo Verde-Água (Cabeçalho Aprendizados) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerAprendizados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Botão Voltar -->
            <ImageButton
                android:id="@+id/btnVoltarAprendizados"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Voltar"
                android:scaleType="fitCenter"
                android:src="@drawable/voltar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Título "Aprendizados" -->
            <TextView
                android:id="@+id/txtTituloAprendizadosHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Aprendizados"
                android:textColor="#111111"
                android:textSize="26sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnVoltarAprendizados" />

            <!-- Subtítulo "Boas práticas e resultados registrados" -->
            <TextView
                android:id="@+id/txtSubtituloAprendizadosHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Boas práticas e resultados registrados"
                android:textColor="#006775"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtTituloAprendizadosHeader" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 2. Cartão Branco com Conteúdo -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerAprendizadosBranco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cartao_topo_arredondado"
            android:minHeight="600dp"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerAprendizados"
            app:layout_constraintVertical_bias="0.0">

            <!-- Card Destaque "Meus aprendizados / Você tem X aprendizados" -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardDestaqueMeusAprendizados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:elevation="4dp"
                android:padding="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/lblMeusAprendizados"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Meus aprendizados"
                    android:textColor="#238357"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/txtQtdAprendizados"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textColor="#083248"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lblMeusAprendizados"
                    tools:text="Você tem 12 aprendizados" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAdicionarNovoAprendizado"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_btn_enviar_resposta"
                    android:clickable="true"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="Adicionar novo"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/txtQtdAprendizados" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Campo de Busca -->
            <EditText
                android:id="@+id/edtBuscarAprendizados"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:hint="Buscar aprendizados"
                android:inputType="text"
                android:paddingHorizontal="16dp"
                android:textColor="#111111"
                android:textColorHint="#757575"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardDestaqueMeusAprendizados" />

            <!-- RecyclerView das Lições Aprendidas -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLicoesAprendidas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/edtBuscarAprendizados"
                tools:listitem="@layout/item_card_licao_aprendida" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
